                "volume_backup.recovery_failed"
              ],
              "storage": true,
              "routes": true,
              "http": [
                "hc-ping.com"
              ],
              "ui": [
                {
                  "slot": "dashboard",
                  "title": "Healthchecks.io",
                  "path": "/panel"
                }
              ]
            },
            "settings": [
              {
                "key": "ping_key",
                "label": "Project ping key",
                "help": "From the project's Settings → Ping key on Healthchecks.io. Each job pings https://hc-ping.com/<ping key>/<slug>.",
                "secret": true,
                "required": true
              },
              {
                "key": "create",
                "label": "Create checks automatically",
                "help": "yes: the first ping of a job creates its check (?create=1). no: only jobs whose check you created are pinged.",
